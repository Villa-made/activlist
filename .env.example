# Cloudflare Workers AI — local-only values for the T02.1 provider spike.
# Copy to .env.local and replace the empty values locally. Never commit .env.local.
# The API token must be restricted to Workers AI permissions; do not enable billing.
VITE_CLOUDFLARE_ACCOUNT_ID=
VITE_CLOUDFLARE_AUTH_TOKEN=

# Local-only, non-identifying test images. Keep this directory ignored by Git.
VITE_AI_SPIKE_RELEVANT_IMAGE=tests/ai/private-fixtures/relevant.jpg
VITE_AI_SPIKE_RELEVANT_DESCRIPTION=
VITE_AI_SPIKE_IRRELEVANT_IMAGE=tests/ai/private-fixtures/irrelevant.jpg
VITE_AI_SPIKE_IRRELEVANT_DESCRIPTION=

# T21 reports: names only. Set the values as Supabase Edge Function secrets, never in the repo.
# TURNSTILE_SECRET_KEY: Cloudflare Turnstile widget secret (server-side siteverify).
# REPORT_RATE_SALT: random secret salt for the report rate-limit key (SHA-256 of IP + salt).
VITE_TURNSTILE_SECRET_KEY=
VITE_REPORT_RATE_SALT=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SERVICE_ROLE_KEY=